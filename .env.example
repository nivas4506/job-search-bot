# Optional: send alerts by email
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
ALERT_FROM_EMAIL=your-email@example.com
ALERT_TO_EMAIL=recipient@example.com

# Optional: tune run behavior
MAX_RESULTS_PER_QUERY=20

# Optional: protect API endpoints and cron trigger
CRON_SECRET=replace_with_long_random_secret

# Optional: persistent dedupe for Vercel/serverless
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
